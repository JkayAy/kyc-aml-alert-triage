# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Worker config
TRIAGE_QUEUE_NAME=aml-triage
AUTO_DISMISS_THRESHOLD=0.30
WORKER_CONCURRENCY=5
GRACE_PERIOD_MS=3600000

# Webhook HMAC secret (shared with the TM engine)
TM_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# NER microservice (optional; falls back to regex-only if unavailable)
NER_SERVICE_URL=http://localhost:8080/analyze

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kyc-aml-triage
